use ::java::util::direction::Axis

// These two density function types were added in Minecraft 26.3.
// Keep the upstream vanilla-mcdoc definitions available to CI even when the
// hosted vanilla-mcdoc dependency has not yet published them.

#[since="26.3"]
dispatch minecraft:density_function[gradient] to struct Gradient {
	axis: Axis,
	/// Defaults to `clamp_to_edge`.
	tiling?: TilingMode,
	from_coordinate: int,
	to_coordinate: int,
	from_value: NoiseRange,
	to_value: NoiseRange,
}

#[since="26.3"]
dispatch minecraft:density_function[lerp] to struct Lerp {
	alpha: DensityFunctionRef,
	first: DensityFunctionRef,
	second: DensityFunctionRef,
}
